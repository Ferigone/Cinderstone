# Only runtime source and its compile-time data enter the build context.
**
!Cargo.toml
!Cargo.lock
!Dockerfile
!.dockerignore
!src/
!src/**
!fixtures/
!fixtures/**
!tools/
!tools/crafting_metadata.json
!tools/container_oracle_equipment.json
!tools/entity_tracking_facts.json
!tools/entity_move_facts.json
!tools/storage_registries.json
!tools/storage_blockentity_defaults.json
!tools/storage_blockentity_factories.json
!tools/player_physics_facts.json
!tools/item_entity_physics_facts.json
!tools/block_state_owner_facts.java
!deploy/
!deploy/start.sh

# Never transfer runtime saves, credentials, Java binaries or local build output.
**/.env
**/.env.*
**/*.jar
**/*.class
**/*.log
**/*.zip
# Exclude root Cargo output; src/worldgen/target is required Rust source.
/target/**
**/runtime/**

!LICENSE
!THIRD_PARTY_NOTICES.md
!licenses/
!licenses/**
!third_party/
!third_party/licenses/
!third_party/licenses/**
